# Copy to /etc/cn360-relay.env (systemd) or export in your shell.
# Every value is optional; these are the defaults.

# Bind address only. HUDs connect to this machine's LAN name or IP, never 0.0.0.0.
RELAY_BIND=0.0.0.0
RELAY_PORT=8081
RELAY_PATH=/detections

# Empty = token check off. To turn it on, set the same value here and in
# n8n's runtime.local.json "relayIngestToken". Generate one with:
#   openssl rand -hex 32
RELAY_INGEST_TOKEN=

RELAY_HEARTBEAT_MS=15000
