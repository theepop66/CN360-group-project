[Unit]
Description=CN360 detection relay (n8n to HUD WebSocket)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cn360
Group=cn360
WorkingDirectory=/opt/cn360/detection-relay
# Optional: without this file the relay uses its defaults, token check off.
EnvironmentFile=-/etc/cn360-relay.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
