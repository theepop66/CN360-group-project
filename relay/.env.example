# Empty = every interface, IPv4 and IPv6.
RELAY_HOST=
RELAY_PORT=8081
RELAY_PATH=/detections
RELAY_MAX_BODY_BYTES=9437184
RELAY_HEARTBEAT_MS=10000
RELAY_MAX_CLIENT_BUFFER_BYTES=4194304
# Optional: require "Authorization: Bearer <token>" on POST.
RELAY_INGEST_TOKEN=
# Optional, comma-separated: only these browser origins may open the WebSocket.
RELAY_ALLOWED_ORIGINS=
